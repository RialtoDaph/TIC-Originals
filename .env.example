# Copy to .env.local for development; set the same variables in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (never expose): used by checkout, the Stripe webhook, order tracking and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use test keys first)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL (Stripe return URL, auth redirects, links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: serve product/site images from a CDN or Supabase Storage bucket with the same paths as /public/img.
NEXT_PUBLIC_IMAGE_BASE_URL=

# Optional: transactional email via Resend (order confirmation, shipping, refunds, invoices, reminders).
# Without a key emails are only logged and the dashboard says so.
RESEND_API_KEY=
EMAIL_FROM="TIC Originals <company@ticoriginals.com>"
# Receives contact-form messages.
OWNER_EMAIL=company@ticoriginals.com

# Optional: Telegram notifications (Settings → Notifications). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
